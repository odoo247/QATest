<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fix Tests Wizard Form View -->
    <record id="view_qa_fix_tests_wizard_form" model="ir.ui.view">
        <field name="name">qa.fix.tests.wizard.form</field>
        <field name="model">qa.fix.tests.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Failed Tests">
                <header>
                    <button name="action_analyze" type="object" 
                            string="Analyze with AI" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apply_all" type="object" 
                            string="Apply All Fixes" class="btn-primary"
                            invisible="state != 'review'"/>
                    <button name="action_apply_selected" type="object" 
                            string="Apply Selected" class="btn-secondary"
                            invisible="state != 'review'"/>
                    <button name="action_rerun_tests" type="object" 
                            string="Re-run Fixed Tests" class="btn-success"
                            invisible="state != 'done' and fixed_count == 0"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span invisible="state != 'draft'">Fix Failed Tests</span>
                            <span invisible="state != 'analyzing'">Analyzing Tests...</span>
                            <span invisible="state != 'review'">Review Suggested Fixes</span>
                            <span invisible="state != 'done'">Fixes Applied</span>
                        </h1>
                    </div>
                    
                    <!-- Progress -->
                    <div class="alert alert-info" role="alert" invisible="state != 'analyzing'">
                        <strong>Analyzing:</strong> <field name="analyzed_count" nolabel="1"/> / <field name="total_count" nolabel="1"/> tests
                    </div>
                    
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <strong>Complete!</strong> <field name="fixed_count" nolabel="1"/> tests fixed.
                    </div>
                    
                    <!-- Source Selection (Draft state) -->
                    <group invisible="state != 'draft'">
                        <group string="Select Failed Tests">
                            <field name="source_type" widget="radio"/>
                            <field name="run_id" invisible="source_type != 'run'"
                                   options="{'no_create': True}"/>
                            <field name="test_case_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Configuration">
                            <field name="config_id"/>
                            <field name="include_context"/>
                            <field name="auto_apply"/>
                        </group>
                    </group>
                    
                    <!-- Review Fixes -->
                    <group string="Suggested Fixes" invisible="state not in ('review', 'done')">
                        <field name="line_ids" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Separate list view for wizard lines -->
    <record id="view_qa_fix_tests_wizard_line_tree" model="ir.ui.view">
        <field name="name">qa.fix.tests.wizard.line.list</field>
        <field name="model">qa.fix.tests.wizard.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="applied" decoration-muted="not selected">
                <field name="selected" widget="boolean_toggle"/>
                <field name="test_name"/>
                <field name="error_message" string="Error" widget="text" optional="show"/>
                <field name="analysis" string="AI Analysis"/>
                <field name="fix_type" widget="badge"/>
                <field name="confidence" widget="badge"/>
                <field name="applied" readonly="1"/>
                <button name="action_view_diff" type="object"
                        string="View Details" icon="fa-eye"/>
                <button name="action_apply_fix" type="object" 
                        string="Apply" icon="fa-check"
                        invisible="applied or not suggested_fix"/>
            </list>
        </field>
    </record>
    
    <!-- Fix Tests Wizard Line Form (for editing/viewing details) -->
    <record id="view_qa_fix_tests_wizard_line_form" model="ir.ui.view">
        <field name="name">qa.fix.tests.wizard.line.form</field>
        <field name="model">qa.fix.tests.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Test Fix Details">
                <sheet>
                    <group>
                        <group>
                            <field name="test_name" readonly="1"/>
                            <field name="fix_type"/>
                            <field name="confidence"/>
                        </group>
                        <group>
                            <field name="selected"/>
                            <field name="applied" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Error Message - prominently displayed -->
                    <group string="Error Message" invisible="not error_message">
                        <div class="alert alert-danger" style="white-space: pre-wrap;">
                            <field name="error_message" nolabel="1" readonly="1"/>
                        </div>
                    </group>
                    
                    <!-- AI Analysis -->
                    <group string="AI Analysis" invisible="not analysis">
                        <div class="alert alert-info" style="white-space: pre-wrap;">
                            <field name="analysis" nolabel="1" readonly="1"/>
                        </div>
                    </group>
                    
                    <notebook>
                        <page string="Original Code" name="original">
                            <field name="original_code" readonly="1" widget="ace" options="{'mode': 'robot'}"/>
                        </page>
                        <page string="Suggested Fix" name="suggested">
                            <field name="suggested_fix" readonly="1" widget="ace" options="{'mode': 'robot'}"/>
                        </page>
                        <page string="Edit Fix" name="edit" invisible="applied">
                            <field name="edited_fix" widget="ace" options="{'mode': 'robot'}"
                                   placeholder="Edit the suggested fix here before applying..."/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply_fix" type="object" 
                            string="Apply Fix" class="btn-primary"
                            invisible="applied"/>
                    <button name="action_skip_test" type="object"
                            string="Skip Test" class="btn-warning"
                            invisible="applied"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Action to open wizard from Test Run -->
    <record id="action_fix_failed_tests_wizard" model="ir.actions.act_window">
        <field name="name">Fix Failed Tests</field>
        <field name="res_model">qa.fix.tests.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_source_type': 'run',
            'default_run_id': active_id,
        }</field>
    </record>
    
    <!-- Action from Test Cases list -->
    <record id="action_fix_selected_tests_wizard" model="ir.actions.act_window">
        <field name="name">Fix Selected Tests</field>
        <field name="res_model">qa.fix.tests.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_source_type': 'selected',
            'default_test_case_ids': active_ids,
        }</field>
    </record>
</odoo>
