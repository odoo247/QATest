<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quick Import Wizard -->
    <record id="view_migration_import_wizard_form" model="ir.ui.view">
        <field name="name">migration.import.wizard.form</field>
        <field name="model">migration.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Import">
                <group>
                    <group>
                        <field name="source_file" filename="source_filename"/>
                        <field name="source_filename" invisible="1"/>
                        <field name="source_type" readonly="1"/>
                    </group>
                    <group>
                        <field name="target_model_id" options="{'no_create': True}"/>
                        <field name="use_template"/>
                        <field name="template_id" invisible="not use_template"
                               domain="[('target_model_id', '=', target_model_id)]"/>
                    </group>
                </group>
                <group>
                    <field name="use_ai_mapping" invisible="use_template"/>
                </group>
                <footer>
                    <button name="action_create_project" string="Create Project" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Value Mapping Wizard -->
    <record id="view_migration_value_mapping_wizard_form" model="ir.ui.view">
        <field name="name">migration.value.mapping.wizard.form</field>
        <field name="model">migration.value.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Value Mapping">
                <field name="mapping_id" invisible="1"/>
                <group>
                    <button name="action_detect_values" string="Detect Values from Data" type="object" class="btn-secondary"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="source_value"/>
                        <field name="target_value"/>
                    </list>
                </field>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Save Template Wizard -->
    <record id="view_migration_save_template_wizard_form" model="ir.ui.view">
        <field name="name">migration.save.template.wizard.form</field>
        <field name="model">migration.save.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Save as Template">
                <field name="project_id" invisible="1"/>
                <group>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="is_shared"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </group>
                <footer>
                    <button name="action_save_template" string="Save Template" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Template Mappings View Wizard -->
    <record id="view_migration_template_mappings_wizard_form" model="ir.ui.view">
        <field name="name">migration.template.mappings.wizard.form</field>
        <field name="model">migration.template.mappings.wizard</field>
        <field name="arch" type="xml">
            <form string="Template Mappings">
                <field name="template_id" invisible="1"/>
                <field name="mappings_display" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
