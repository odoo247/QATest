<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Migration Template Form View -->
    <record id="view_migration_template_form" model="ir.ui.view">
        <field name="name">migration.template.form</field>
        <field name="model">migration.template</field>
        <field name="arch" type="xml">
            <form string="Migration Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_duplicate" type="object" class="oe_stat_button" icon="fa-copy">
                            <span>Duplicate</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Configuration">
                            <field name="target_model_id" options="{'no_create': True}"/>
                            <field name="source_type"/>
                            <field name="csv_delimiter" invisible="source_type != 'csv'"/>
                            <field name="csv_encoding" invisible="source_type != 'csv'"/>
                            <field name="has_header"/>
                        </group>
                        <group string="Import Settings">
                            <field name="batch_size"/>
                            <field name="on_error"/>
                            <field name="create_if_not_exists"/>
                            <field name="update_existing"/>
                            <field name="unique_field_id" invisible="not update_existing"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Sharing">
                            <field name="is_shared"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Usage Statistics">
                            <field name="use_count" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe this template..."/>
                        </page>
                        <page string="Mappings Configuration" name="mappings">
                            <field name="mappings_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Migration Template Tree View -->
    <record id="view_migration_template_tree" model="ir.ui.view">
        <field name="name">migration.template.tree</field>
        <field name="model">migration.template</field>
        <field name="arch" type="xml">
            <tree string="Migration Templates">
                <field name="name"/>
                <field name="target_model_id"/>
                <field name="source_type"/>
                <field name="is_shared"/>
                <field name="use_count"/>
                <field name="last_used"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </tree>
        </field>
    </record>

    <!-- Migration Template Search View -->
    <record id="view_migration_template_search" model="ir.ui.view">
        <field name="name">migration.template.search</field>
        <field name="model">migration.template</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="target_model_id"/>
                <field name="tag_ids"/>
                <filter name="filter_shared" string="Shared" domain="[('is_shared', '=', True)]"/>
                <filter name="filter_my" string="My Templates" domain="[('create_uid', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_model" string="Target Model" context="{'group_by': 'target_model_id'}"/>
                    <filter name="group_type" string="Source Type" context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_migration_template" model="ir.actions.act_window">
        <field name="name">Migration Templates</field>
        <field name="res_model">migration.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_migration_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first migration template
            </p>
            <p>
                Templates save your migration configurations for reuse across multiple imports.
            </p>
        </field>
    </record>

    <!-- Template Tag Views -->
    <record id="view_migration_template_tag_tree" model="ir.ui.view">
        <field name="name">migration.template.tag.tree</field>
        <field name="model">migration.template.tag</field>
        <field name="arch" type="xml">
            <tree string="Template Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_migration_template_tag" model="ir.actions.act_window">
        <field name="name">Template Tags</field>
        <field name="res_model">migration.template.tag</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
