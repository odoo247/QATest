<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cleanup old migration logs -->
        <record id="ir_cron_migration_log_cleanup" model="ir.cron">
            <field name="name">Migration: Cleanup Old Logs</field>
            <field name="model_id" ref="model_migration_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs(days=90)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <!-- Process queued imports (for large files) -->
        <record id="ir_cron_process_queued_imports" model="ir.cron">
            <field name="name">Migration: Process Queued Imports</field>
            <field name="model_id" ref="model_migration_project"/>
            <field name="state">code</field>
            <field name="code">model.process_queued_imports()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
