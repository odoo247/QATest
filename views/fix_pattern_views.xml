<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fix Pattern Tree View -->
    <record id="view_qa_fix_pattern_tree" model="ir.ui.view">
        <field name="name">qa.fix.pattern.tree</field>
        <field name="model">qa.fix.pattern</field>
        <field name="arch" type="xml">
            <list string="Fix Patterns" decoration-success="verified" decoration-muted="not active">
                <field name="name"/>
                <field name="error_pattern"/>
                <field name="model_name"/>
                <field name="verified" widget="boolean"/>
                <field name="success_count"/>
                <field name="success_rate" widget="progressbar"/>
                <field name="source" widget="badge"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Fix Pattern Form View -->
    <record id="view_qa_fix_pattern_form" model="ir.ui.view">
        <field name="name">qa.fix.pattern.form</field>
        <field name="model">qa.fix.pattern</field>
        <field name="arch" type="xml">
            <form string="Fix Pattern">
                <sheet>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not verified"/>
                    <widget name="web_ribbon" title="Not Verified" bg_color="text-bg-warning" invisible="verified"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Pattern Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Error Matching">
                            <field name="error_pattern" placeholder="e.g., Invalid field 'product_uom'"/>
                            <field name="error_regex" placeholder="Optional regex"/>
                            <field name="model_name" placeholder="e.g., sale.order.line"/>
                        </group>
                        <group string="Version &amp; Stats">
                            <field name="odoo_version_min" placeholder="e.g., 17.0"/>
                            <field name="odoo_version_max" placeholder="e.g., 19.0"/>
                            <field name="times_suggested"/>
                            <field name="success_count"/>
                            <field name="success_rate" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Verification">
                            <field name="verified"/>
                            <field name="verified_by" invisible="not verified"/>
                            <field name="verified_date" invisible="not verified"/>
                            <field name="source"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problem &amp; Solution" name="solution">
                            <group>
                                <field name="problem" placeholder="What causes this error..."/>
                            </group>
                            <group>
                                <field name="solution" placeholder="How to fix it..."/>
                            </group>
                        </page>
                        <page string="Code Examples" name="code">
                            <group string="Wrong Code (causes error)">
                                <field name="wrong_code" widget="ace" options="{'mode': 'robot'}" nolabel="1"/>
                            </group>
                            <group string="Correct Code (fix)">
                                <field name="correct_code" widget="ace" options="{'mode': 'robot'}" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Source" name="source" invisible="source != 'learned'">
                            <group>
                                <field name="source_test_case_id"/>
                                <field name="source_error"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fix Pattern Search View -->
    <record id="view_qa_fix_pattern_search" model="ir.ui.view">
        <field name="name">qa.fix.pattern.search</field>
        <field name="model">qa.fix.pattern</field>
        <field name="arch" type="xml">
            <search string="Search Fix Patterns">
                <field name="name"/>
                <field name="error_pattern"/>
                <field name="model_name"/>
                <filter string="Verified" name="verified" domain="[('verified', '=', True)]"/>
                <filter string="Not Verified" name="not_verified" domain="[('verified', '=', False)]"/>
                <separator/>
                <filter string="Learned" name="learned" domain="[('source', '=', 'learned')]"/>
                <filter string="System" name="system" domain="[('source', '=', 'system')]"/>
                <filter string="Manual" name="manual" domain="[('source', '=', 'manual')]"/>
                <group expand="0" string="Group By">
                    <filter string="Model" name="group_model" context="{'group_by': 'model_name'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Verified" name="group_verified" context="{'group_by': 'verified'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fix Pattern Action -->
    <record id="action_qa_fix_pattern" model="ir.actions.act_window">
        <field name="name">Fix Patterns (Knowledge Base)</field>
        <field name="res_model">qa.fix.pattern</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_verified': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fix patterns in knowledge base
            </p>
            <p>
                Fix patterns are learned when:
                <ol>
                    <li>AI suggests a fix</li>
                    <li>You apply and run the test</li>
                    <li>Test PASSES</li>
                    <li>You click "Save Fix to Knowledge Base"</li>
                </ol>
                Only verified fixes are used to help the AI.
            </p>
        </field>
    </record>
</odoo>
