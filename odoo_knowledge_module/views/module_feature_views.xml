<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_module_feature_tree" model="ir.ui.view">
        <field name="name">ai.module.feature.tree</field>
        <field name="model">ai.module.feature</field>
        <field name="arch" type="xml">
            <list><field name="module"/><field name="name"/><field name="module_category"/><field name="edition"/></list>
        </field>
    </record>
    <record id="view_module_feature_form" model="ir.ui.view">
        <field name="name">ai.module.feature.form</field>
        <field name="model">ai.module.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><group><field name="module"/><field name="name"/><field name="module_category"/></group>
                    <group><field name="edition"/><field name="keywords"/></group></group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                    <group><group string="Capabilities"><field name="capabilities" nolabel="1"/></group>
                    <group string="Limitations"><field name="limitations" nolabel="1"/></group></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_module_feature" model="ir.actions.act_window">
        <field name="name">Standard Features</field><field name="res_model">ai.module.feature</field><field name="view_mode">list,form</field>
    </record>
</odoo>
