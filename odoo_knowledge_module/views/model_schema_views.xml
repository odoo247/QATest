<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_model_schema_tree" model="ir.ui.view">
        <field name="name">ai.model.schema.tree</field>
        <field name="model">ai.model.schema</field>
        <field name="arch" type="xml">
            <list><field name="model_name"/><field name="odoo_version"/><field name="field_count"/></list>
        </field>
    </record>
    <record id="view_model_schema_form" model="ir.ui.view">
        <field name="name">ai.model.schema.form</field>
        <field name="model">ai.model.schema</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="model_name"/><field name="odoo_version"/><field name="field_count"/></group>
                    <group string="Fields (JSON)"><field name="fields_json" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_model_schema" model="ir.actions.act_window">
        <field name="name">Model Schemas</field><field name="res_model">ai.model.schema</field><field name="view_mode">list,form</field>
    </record>
</odoo>
