<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_breaking_change_tree" model="ir.ui.view">
        <field name="name">ai.breaking.change.tree</field>
        <field name="model">ai.breaking.change</field>
        <field name="arch" type="xml">
            <list><field name="from_version"/><field name="to_version"/><field name="category"/><field name="model_name"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_breaking_change_form" model="ir.ui.view">
        <field name="name">ai.breaking.change.form</field>
        <field name="model">ai.breaking.change</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><group><field name="from_version"/><field name="to_version"/><field name="category"/></group>
                    <group><field name="model_name"/><field name="field_name"/><field name="method_name"/></group></group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                    <group><group string="Old Code"><field name="old_code" nolabel="1"/></group>
                    <group string="New Code"><field name="new_code" nolabel="1"/></group></group>
                    <group string="Migration Hint"><field name="migration_hint" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_breaking_change" model="ir.actions.act_window">
        <field name="name">Breaking Changes</field><field name="res_model">ai.breaking.change</field><field name="view_mode">list,form</field>
    </record>
</odoo>
