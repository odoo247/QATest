<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_error_pattern_tree" model="ir.ui.view">
        <field name="name">ai.error.pattern.tree</field>
        <field name="model">ai.error.pattern</field>
        <field name="arch" type="xml">
            <list><field name="odoo_version"/><field name="task_type"/><field name="error_type"/><field name="occurrences"/><field name="resolved"/></list>
        </field>
    </record>
    <record id="view_error_pattern_form" model="ir.ui.view">
        <field name="name">ai.error.pattern.form</field>
        <field name="model">ai.error.pattern</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><group><field name="odoo_version"/><field name="task_type"/><field name="error_type"/></group>
                    <group><field name="model_name"/><field name="occurrences"/><field name="resolved"/></group></group>
                    <group string="Error Message"><field name="error_message" nolabel="1"/></group>
                    <group><group string="Wrong Code"><field name="wrong_code" nolabel="1"/></group>
                    <group string="Correct Code"><field name="correct_code" nolabel="1"/></group></group>
                    <group string="Fix Explanation"><field name="fix_explanation" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_error_pattern" model="ir.actions.act_window">
        <field name="name">Error Patterns</field><field name="res_model">ai.error.pattern</field><field name="view_mode">list,form</field>
    </record>
</odoo>
