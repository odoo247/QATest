<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_code_pattern_tree" model="ir.ui.view">
        <field name="name">ai.code.pattern.tree</field>
        <field name="model">ai.code.pattern</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="category"/><field name="odoo_version"/><field name="description"/></list>
        </field>
    </record>
    <record id="view_code_pattern_form" model="ir.ui.view">
        <field name="name">ai.code.pattern.form</field>
        <field name="model">ai.code.pattern</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><group><field name="name"/><field name="category"/></group>
                    <group><field name="odoo_version"/><field name="tags"/></group></group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                    <group string="Code Template"><field name="code_template" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_code_pattern" model="ir.actions.act_window">
        <field name="name">Code Patterns</field><field name="res_model">ai.code.pattern</field><field name="view_mode">list,form</field>
    </record>
</odoo>
